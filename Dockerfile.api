
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY ["RaceDay .Api/RaceDay .Api/RaceDay .Api.csproj", "RaceDay .Api/RaceDay .Api/"]

RUN dotnet restore "RaceDay .Api/RaceDay .Api/RaceDay .Api.csproj"

COPY . .

WORKDIR /src/RaceDay .Api/RaceDay .Api

RUN dotnet publish "RaceDay .Api.csproj" --configuration Release --output /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final
WORKDIR /app

COPY --from=build /app/publish .

ENV ASPNETCORE_HTTP_PORTS=8081

EXPOSE 8081

ENTRYPOINT ["dotnet", "RaceDay .Api.dll"]
