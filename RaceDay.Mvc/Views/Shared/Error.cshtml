@{
    ViewData["Title"] = "Something went wrong";
}
<div class="empty-state error-state">
    <p class="eyebrow">RACEDAY</p>
    <h1>We could not complete that request</h1>
    <p class="text-muted">Please return to your dashboard and try again. If the problem continues, check that the RaceDay API is running.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Return to RaceDay</a>
</div>
