@{
    var role = Context.Session.GetString("Role");
    var fullName = Context.Session.GetString("FullName") ?? "RaceDay member";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg navbar-dark container py-3">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">R</span>
                <span>RaceDay</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    @if (role == "Organiser")
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Index">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Events">My events</a></li>
                    }
                    else if (role == "Participant")
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Find events</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="Enrolments">My enrolments</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="Results">My results</a></li>
                    }
                </ul>
                @if (role is not null)
                {
                    <div class="d-flex align-items-center gap-3 text-white">
                        <span class="small d-none d-md-inline">@fullName</span>
                        @if (role == "Participant")
                        {
                            <a class="btn btn-outline-light btn-sm" asp-controller="Participant" asp-action="Profile">Profile</a>
                        }
                        @if (role == "Organiser")
                        {
                            <a class="btn btn-outline-light btn-sm" asp-controller="Organiser" asp-action="Index">Account</a>
                        }
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="btn btn-warning btn-sm fw-semibold">Sign out</button>
                        </form>
                    </div>
                }
                else
                {
                    <div class="d-flex gap-2">
                        <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">Sign in</a>
                        <a class="btn btn-warning btn-sm fw-semibold" asp-controller="Account" asp-action="Register">Create account</a>
                    </div>
                }
            </div>
        </nav>
    </header>

    <main class="container py-4 py-lg-5">
        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @successMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["WarningMessage"] is string warningMessage)
        {
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                @warningMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @errorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container d-flex flex-column flex-md-row justify-content-between gap-2">
            <span>RaceDay © 2026</span>
            <span>Run together. Go further.</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
