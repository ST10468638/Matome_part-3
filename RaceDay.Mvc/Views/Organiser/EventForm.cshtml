@model EventFormViewModel
@{
    var isEdit = Model.EventId > 0;
    ViewData["Title"] = isEdit ? "Edit event" : "Create event";
}
<div class="page-heading mb-4"><p class="eyebrow">EVENT DETAILS</p><h1>@(isEdit ? "Update event" : "Create an event")</h1><p class="text-muted">Enter the event information and add a banner image.</p></div>
<div class="content-panel form-panel">
    <form asp-action="@(isEdit ? "EditEvent" : "CreateEvent")" asp-route-id="@Model.EventId" method="post" enctype="multipart/form-data" novalidate>
        <input asp-for="EventId" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <div class="row g-3">
            <div class="col-md-8"><label asp-for="EventName" class="form-label"></label><input asp-for="EventName" class="form-control" /><span asp-validation-for="EventName" class="text-danger small"></span></div>
            <div class="col-md-4"><label asp-for="EventType" class="form-label"></label><select asp-for="EventType" class="form-select"><option>Running</option><option>Walking</option><option>Cycling</option></select><span asp-validation-for="EventType" class="text-danger small"></span></div>
            <div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" rows="3" class="form-control"></textarea><span asp-validation-for="Description" class="text-danger small"></span></div>
            <div class="col-md-4"><label asp-for="DistanceKm" class="form-label"></label><div class="input-group"><input asp-for="DistanceKm" class="form-control" type="number" min="0.01" max="9999.99" step="0.01" /><span class="input-group-text">km</span></div><span asp-validation-for="DistanceKm" class="text-danger small"></span></div>
            <div class="col-md-8"><label asp-for="EventDate" class="form-label"></label><input asp-for="EventDate" type="datetime-local" value="@Model.EventDate.ToString("yyyy-MM-ddTHH:mm")" class="form-control" /><span asp-validation-for="EventDate" class="text-danger small"></span></div>
            <div class="col-md-6"><label asp-for="Venue" class="form-label"></label><input asp-for="Venue" class="form-control" /><span asp-validation-for="Venue" class="text-danger small"></span></div>
            <div class="col-md-3"><label asp-for="City" class="form-label"></label><input asp-for="City" class="form-control" /><span asp-validation-for="City" class="text-danger small"></span></div>
            <div class="col-md-3"><label asp-for="Province" class="form-label"></label><input asp-for="Province" class="form-control" /><span asp-validation-for="Province" class="text-danger small"></span></div>
            <div class="col-md-6"><label asp-for="RegistrationOpenDate" class="form-label"></label><input asp-for="RegistrationOpenDate" type="datetime-local" value="@Model.RegistrationOpenDate.ToString("yyyy-MM-ddTHH:mm")" class="form-control" /><span asp-validation-for="RegistrationOpenDate" class="text-danger small"></span></div>
            <div class="col-md-6"><label asp-for="RegistrationCloseDate" class="form-label"></label><input asp-for="RegistrationCloseDate" type="datetime-local" value="@Model.RegistrationCloseDate.ToString("yyyy-MM-ddTHH:mm")" class="form-control" /><span asp-validation-for="RegistrationCloseDate" class="text-danger small"></span></div>
            <div class="col-md-6"><label asp-for="MaxParticipants" class="form-label"></label><input asp-for="MaxParticipants" type="number" min="1" class="form-control" /><span asp-validation-for="MaxParticipants" class="text-danger small"></span></div>
            <div class="col-md-6"><label asp-for="BannerImage" class="form-label"></label><input asp-for="BannerImage" type="file" class="form-control" accept="image/jpeg,image/png,image/webp" /><div class="form-hint">JPEG, PNG or WebP, maximum 5 MB. Select a new image to replace the existing banner.</div><span asp-validation-for="BannerImage" class="text-danger small"></span></div>
            @if (!string.IsNullOrWhiteSpace(Model.CurrentBannerImageUrl))
            {
                <div class="col-12"><p class="form-label">Current banner</p><img src="@Model.CurrentBannerImageUrl" alt="Current event banner" class="current-banner" /></div>
            }
        </div>
        <div class="d-flex flex-wrap gap-2 mt-4"><button type="submit" class="btn btn-primary">@(isEdit ? "Save changes" : "Create event")</button><a asp-action="Events" class="btn btn-outline-secondary">Cancel</a></div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
