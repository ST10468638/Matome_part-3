@model IReadOnlyCollection<EventDto>
@{
    ViewData["Title"] = "Find events";
}
<section class="hero-panel mb-4 mb-lg-5">
    <div class="hero-copy">
        <p class="eyebrow text-warning">YOUR NEXT START LINE</p>
        <h1>Find your next<br /><span>RaceDay.</span></h1>
        <p>Discover running, walking and cycling events. Choose your category and secure your place.</p>
    </div>
    <div class="hero-stats">
        <div><strong>RUN</strong><span>Push your pace</span></div>
        <div><strong>WALK</strong><span>Find your stride</span></div>
        <div><strong>RIDE</strong><span>Go further</span></div>
    </div>
</section>
<div class="d-flex flex-column flex-lg-row align-items-lg-end justify-content-between gap-3 mb-4">
    <div>
        <p class="eyebrow">UPCOMING EVENTS</p>
        <h2 class="section-title mb-0">Choose your challenge</h2>
    </div>
    <form method="get" class="filter-bar">
        <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search events or locations" aria-label="Search events" />
        <select name="eventType" class="form-select" aria-label="Filter by event type">
            @if (string.IsNullOrWhiteSpace(ViewBag.EventType as string))
            {
                <option value="" selected>All activities</option>
            }
            else
            {
                <option value="">All activities</option>
            }
            @foreach (var activity in new[] { "Running", "Walking", "Cycling" })
            {
                if (string.Equals(ViewBag.EventType as string, activity, StringComparison.OrdinalIgnoreCase))
                {
                    <option value="@activity" selected>@activity</option>
                }
                else
                {
                    <option value="@activity">@activity</option>
                }
            }
        </select>
        <button class="btn btn-primary" type="submit">Filter</button>
    </form>
</div>
@if (!Model.Any())
{
    <div class="empty-state"><h3>No upcoming events found</h3><p>Try another search or check back when new events are published.</p></div>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-xl-4">
                <article class="event-card h-100">
                    @if (!string.IsNullOrWhiteSpace(item.BannerImageUrl))
                    {
                        <img src="@item.BannerImageUrl" class="event-card-image" alt="Banner for @item.EventName" />
                    }
                    else
                    {
                        <div class="event-card-placeholder"><span>@item.EventType</span></div>
                    }
                    <div class="event-card-body">
                        <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
                            <span class="activity-tag">@item.EventType</span>
                            <span class="text-muted small">@item.DistanceKm.ToString("0.##") km</span>
                        </div>
                        <h3>@item.EventName</h3>
                        <p class="event-location">@item.Venue, @item.City</p>
                        <p class="text-muted small mb-4">@item.EventDate.ToString("ddd, dd MMM yyyy · HH:mm")</p>
                        <a asp-controller="Participant" asp-action="Details" asp-route-id="@item.EventId" class="btn btn-outline-primary w-100">View event</a>
                    </div>
                </article>
            </div>
        }
    </div>
}
