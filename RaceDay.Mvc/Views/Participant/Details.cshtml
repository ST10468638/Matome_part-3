@model EventDto
@{
    ViewData["Title"] = "Event details";
    var categories = ViewBag.Categories as IReadOnlyCollection<CategoryDto> ?? Array.Empty<CategoryDto>();
    var registrationOpen = DateTime.Now >= Model.RegistrationOpenDate && DateTime.Now <= Model.RegistrationCloseDate;
}
<a asp-controller="Home" asp-action="Index" class="back-link">← Back to events</a>
<section class="detail-hero mb-4">
    @if (!string.IsNullOrWhiteSpace(Model.BannerImageUrl))
    {
        <img src="@Model.BannerImageUrl" alt="Banner for @Model.EventName" class="detail-banner" />
    }
    else
    {
        <div class="detail-banner-placeholder"><span>@Model.EventType</span><strong>@Model.DistanceKm.ToString("0.##") km</strong></div>
    }
    <div class="detail-heading">
        <div><span class="activity-tag">@Model.EventType</span><h1>@Model.EventName</h1><p>@Model.Venue, @Model.City, @Model.Province</p></div>
        <div class="detail-date"><span>EVENT DATE</span><strong>@Model.EventDate.ToString("dd MMM yyyy")</strong><small>@Model.EventDate.ToString("HH:mm")</small></div>
    </div>
</section>
<div class="row g-4">
    <div class="col-lg-8">
        <section class="content-panel h-100">
            <p class="eyebrow">ABOUT THIS EVENT</p>
            <h2>Event information</h2>
            <p class="text-readable">@Model.Description</p>
            <div class="event-facts">
                <div><span>Distance</span><strong>@Model.DistanceKm.ToString("0.##") km</strong></div>
                <div><span>Venue</span><strong>@Model.Venue</strong></div>
                <div><span>City</span><strong>@Model.City</strong></div>
                <div><span>Province</span><strong>@Model.Province</strong></div>
                <div><span>Registration opens</span><strong>@Model.RegistrationOpenDate.ToString("dd MMM yyyy")</strong></div>
                <div><span>Registration closes</span><strong>@Model.RegistrationCloseDate.ToString("dd MMM yyyy")</strong></div>
            </div>
        </section>
    </div>
    <div class="col-lg-4">
        <section class="content-panel h-100">
            <p class="eyebrow">CHOOSE YOUR PLACE</p>
            <h2>Available categories</h2>
            @if (!categories.Any())
            {
                <p class="text-muted">No categories have been published for this event yet.</p>
            }
            else
            {
                foreach (var category in categories)
                {
                    <div class="category-option">
                        <div><strong>@category.CategoryName</strong><p class="small text-muted mb-1">@if (category.CategoryType == "Age") { <span>@category.MinimumAge–@category.MaximumAge years</span> } else { <span>@category.DistanceKm km</span> }</p><span class="small">R @category.EntryFee.ToString("N2") · Capacity @category.Capacity</span></div>
                        @if (registrationOpen)
                        {
                            <form asp-action="Enrol" method="post" onsubmit="return confirm('Confirm your enrolment in this category?');">
                                <input type="hidden" name="eventId" value="@Model.EventId" />
                                <input type="hidden" name="categoryId" value="@category.CategoryId" />
                                <button type="submit" class="btn btn-primary btn-sm">Enrol</button>
                            </form>
                        }
                    </div>
                }
            }
            @if (!registrationOpen)
            {
                <div class="alert alert-warning mt-3 mb-0">Registration is not currently open.</div>
            }
        </section>
    </div>
</div>
