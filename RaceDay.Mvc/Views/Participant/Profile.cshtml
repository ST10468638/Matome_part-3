@model ProfileFormViewModel
@{
    ViewData["Title"] = "My profile";
}
<div class="page-heading mb-4"><p class="eyebrow">ACCOUNT SETTINGS</p><h1>My profile</h1><p class="text-muted">Keep your contact information up to date.</p></div>
<div class="content-panel form-panel profile-panel">
    <form asp-action="Profile" method="post" enctype="multipart/form-data" novalidate>
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <div class="profile-photo-wrap">
            @if (!string.IsNullOrWhiteSpace(Model.ProfilePictureUrl))
            {
                <img src="@Model.ProfilePictureUrl" alt="Your profile picture" class="profile-photo" />
            }
            else
            {
                <div class="profile-photo-placeholder">@Model.FirstName.FirstOrDefault()@Model.LastName.FirstOrDefault()</div>
            }
            <div><strong>@Model.FirstName @Model.LastName</strong><div class="text-muted small">@Model.Role</div></div>
        </div>
        <div class="row g-3 mt-2">
            <div class="col-md-6"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control" /><span asp-validation-for="FirstName" class="text-danger small"></span></div>
            <div class="col-md-6"><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control" /><span asp-validation-for="LastName" class="text-danger small"></span></div>
            <div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger small"></span></div>
            <div class="col-md-6"><label asp-for="PhoneNumber" class="form-label"></label><input asp-for="PhoneNumber" class="form-control" /><span asp-validation-for="PhoneNumber" class="text-danger small"></span></div>
            <div class="col-12"><label asp-for="ProfilePicture" class="form-label"></label><input asp-for="ProfilePicture" class="form-control" type="file" accept="image/jpeg,image/png,image/webp" /><div class="form-hint">JPEG, PNG or WebP, maximum 5 MB.</div><span asp-validation-for="ProfilePicture" class="text-danger small"></span></div>
        </div>
        <button type="submit" class="btn btn-primary mt-4">Save profile</button>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
